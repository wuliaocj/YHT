<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.RoleMapper">

    <resultMap id="RoleResultMap" type="com.example.demo.domain.Role">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectById" resultMap="RoleResultMap">
        select * from role where id = #{id}
    </select>

    <select id="selectAll" resultMap="RoleResultMap">
        select * from role order by create_time desc
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into role(name, description, status, create_time, update_time)
        values (#{name}, #{description}, #{status}, #{createTime}, #{updateTime})
    </insert>

    <update id="update">
        update role
        set name = #{name},
            description = #{description},
            status = #{status},
            update_time = #{updateTime}
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from role where id = #{id}
    </delete>

    <select id="selectByPage" resultMap="RoleResultMap">
        select * from role
        <where>
            <if test="wrapper != null">
                ${wrapper.sqlSegment}
            </if>
        </where>
        limit #{offset}, #{limit}
    </select>

    <select id="selectCount" resultType="java.lang.Long">
        select count(*) from role
        <where>
            <if test="wrapper != null">
                ${wrapper.sqlSegment}
            </if>
        </where>
    </select>
</mapper>