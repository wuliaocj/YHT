<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.PermissionMapper">

    <resultMap id="PermissionResultMap" type="com.example.demo.domain.Permission">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="url" property="url"/>
        <result column="method" property="method"/>
        <result column="parent_id" property="parentId"/>
        <result column="sort" property="sort"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectById" resultMap="PermissionResultMap">
        select * from permission where id = #{id}
    </select>

    <select id="selectAll" resultMap="PermissionResultMap">
        select * from permission order by sort asc, create_time desc
    </select>

    <select id="selectByRoleId" resultMap="PermissionResultMap">
        select p.* from permission p
        join role_permission rp on p.id = rp.permission_id
        where rp.role_id = #{roleId}
        order by p.sort asc, p.create_time desc
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into permission(name, description, url, method, parent_id, sort, create_time, update_time)
        values (#{name}, #{description}, #{url}, #{method}, #{parentId}, #{sort}, #{createTime}, #{updateTime})
    </insert>

    <update id="update">
        update permission
        set name = #{name},
            description = #{description},
            url = #{url},
            method = #{method},
            parent_id = #{parentId},
            sort = #{sort},
            update_time = #{updateTime}
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from permission where id = #{id}
    </delete>

    <select id="selectByPage" resultMap="PermissionResultMap">
        select * from permission
        <where>
            <if test="wrapper != null">
                ${wrapper.sqlSegment}
            </if>
        </where>
        limit #{offset}, #{limit}
    </select>

    <select id="selectCount" resultType="java.lang.Long">
        select count(*) from permission
        <where>
            <if test="wrapper != null">
                ${wrapper.sqlSegment}
            </if>
        </where>
    </select>
</mapper>